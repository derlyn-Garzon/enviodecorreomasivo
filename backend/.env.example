# URL del proyecto Supabase, ej: https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Service Role Key (secreto). Necesaria para que el cron lea las postulaciones
# pendientes y las marque como entregadas saltándose RLS. NUNCA la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=

# Endpoint (webhook/API) del reclutador que recibe cada postulación.
RECRUITER_ENDPOINT=

# Bearer opcional para autenticar contra el endpoint del reclutador.
RECRUITER_TOKEN=

# Máximo de postulaciones a procesar por ejecución del cron.
CRON_BATCH_SIZE=50
